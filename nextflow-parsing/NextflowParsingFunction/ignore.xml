<?xml version="1.0" encoding="UTF-8"?>
<!-- Ignore generated files that we have little control over -->
<FindBugsFilter>
    <Match>
        <Source name="WorkflowsApi.java"/>
    </Match>
    <Match>
        <Source name="ServerVariable.java"/>
    </Match>
    <Match>
        <Source name="ServerConfiguration.java"/>
    </Match>
    <Match>
        <Source name="ApiClient.java"/>
    </Match>
    <!-- NextflowHandler is a simple bean; newer SpotBugs flags its getters/setters -->
    <Match>
        <Class name="io.dockstore.nextflowparsing.NextflowHandler"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
